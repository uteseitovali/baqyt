# ============================================================================
# Bagyt — переменные окружения
#
# ВАЖНО: приложение полностью работает БЕЗ единой переменной из этого файла.
# Без них каталог отдаётся из статического среза (src/lib/data/programs.ts),
# путь хранится в localStorage браузера, а входа в аккаунт просто нет —
# кнопка не показывается, ни одного запроса к /api/auth не уходит.
#
# Каждый блок ниже включается независимо от остальных.
# ============================================================================

# ——— AI: переписывает формулировки живым языком ———————————————————————
#
# Ключ провайдера, совместимого с OpenAI /chat/completions.
# Оставьте пустым — интерфейс честно покажет «текст собран правилами».
AI_API_KEY=

# Базовый URL провайдера. Примеры:
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://localhost:11434/v1
AI_BASE_URL=https://api.openai.com/v1

# Модель. Подойдёт любая недорогая с поддержкой JSON-режима.
AI_MODEL=gpt-4o-mini

# Таймаут обращения к модели, мс. По истечении отдаём детерминированный текст.
AI_TIMEOUT_MS=12000


# ——— База данных: живой каталог и аккаунты ————————————————————————————
#
# Одна переменная включает сразу три вещи: каталог программ читается из
# Postgres, появляется вход по коду, прогресс синхронизируется между
# устройствами. Если база не отвечает — приложение автоматически
# возвращается к статическому срезу, причина видна в GET /api/health.
#
# Локальный Postgres в Docker:
#   docker run -d --name bagyt-db -e POSTGRES_PASSWORD=bagyt \
#     -e POSTGRES_USER=bagyt -e POSTGRES_DB=bagyt -p 5432:5432 postgres:16
#   npm run db:setup
DATABASE_URL=

# TLS для облачных провайдеров (Neon, Supabase, Render). Локальному Docker
# не нужно. Распознаётся и sslmode=require прямо в строке подключения.
DATABASE_SSL=

# Размер пула и верхняя граница на запрос. Лучше деградировать в статику,
# чем заставлять пользователя ждать.
DATABASE_POOL_MAX=5
DATABASE_TIMEOUT_MS=5000

# Сколько держать каталог в памяти процесса перед перечитыванием, мс.
CATALOG_TTL_MS=60000


# ——— Запись в каталог ————————————————————————————————————————————————
#
# POST/PATCH/DELETE /api/programs требуют заголовок
#   Authorization: Bearer <ADMIN_TOKEN>
#
# Пока переменная пуста, запись ВЫКЛЮЧЕНА (503), а не открыта всем:
# забытая настройка не должна оборачиваться открытым CRUD.
ADMIN_TOKEN=


# ——— Вход по одноразовому коду ————————————————————————————————————————
#
# «Перец» для хэша кода: с ним дампа базы недостаточно, чтобы перебрать
# шестизначный код офлайн. Любая длинная случайная строка.
AUTH_SECRET=

# Показывать код входа прямо в ответе API и на экране входа.
# Только для локального демо: в продакшене игнорируется.
# Почтовый провайдер в этой версии не подключён — по умолчанию код
# печатается в лог сервера.
AUTH_DEV_SHOW_CODE=
